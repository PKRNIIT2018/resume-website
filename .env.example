# Resend API key for contact form email delivery
# Get your free key at https://resend.com → API Keys
RESEND_API_KEY=re_your_api_key_here
ADMIN_RESUME_PASSWORD=your_secret_password_here
# At least 32 random characters. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace_with_a_long_random_value

# Gemini API key for the /admin/cover-letter tool
# Get your free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
